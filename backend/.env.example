# Copier ce fichier en .env et remplir les valeurs.

# Chaîne de connexion fournie par Neon (poolée). L'URL directe pour les
# migrations en est déduite automatiquement (voir prisma.config.ts).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Une longue chaîne aléatoire (ex. : openssl rand -hex 32)
JWT_SECRET=

PORT=3000
FRONTEND_URL=http://localhost:4200

# Assistant : fournisseur compatible OpenAI. Groq par défaut (offre gratuite : console.groq.com)
AI_API_KEY=
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL=llama-3.3-70b-versatile

# Garde-fous du widget public
WIDGET_DAILY_LIMIT=200
WIDGET_VISITOR_HOURLY_LIMIT=20
