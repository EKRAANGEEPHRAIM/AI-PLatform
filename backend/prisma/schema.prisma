// Akwaba : assistant de service client pour PME.
// Une entreprise (Tenant) = une base de connaissances + un widget de chat pour son site.

generator client {
  // Client généré dans node_modules/@prisma/client, importé tel quel par le code
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Informations de l'entreprise sur lesquelles l'assistant s'appuie (FAQ, prix, horaires…)
  knowledgeBase  String @default("")
  /// Comment joindre un humain quand l'assistant ne sait pas répondre
  contactInfo    String @default("")
  welcomeMessage String @default("Bonjour ! Comment puis-je vous aider ?")
  brandColor     String @default("#0f766e")
  /// Identifiant public du widget, inséré dans le site de l'entreprise
  widgetKey      String @unique @default(cuid())

  users         User[]
  conversations Conversation[]

  @@map("tenants")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId      String?
  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  conversations Conversation[]

  @@map("users")
}

model Conversation {
  id        String             @id @default(cuid())
  title     String
  status    ConversationStatus @default(ACTIVE)
  /// INTERNAL : test par l'équipe ; WIDGET : visiteur du site de l'entreprise
  channel   Channel            @default(INTERNAL)
  /// Identifiant anonyme du visiteur (navigateur), pour les conversations du widget
  visitorId String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  userId   String?
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String?
  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([tenantId])
  @@index([tenantId, visitorId])
  @@map("conversations")
}

model Message {
  id        String      @id @default(cuid())
  content   String
  role      MessageRole
  createdAt DateTime    @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

enum Role {
  USER
  ADMIN
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  RESOLVED
}

enum Channel {
  INTERNAL
  WIDGET
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}
